# Copia este archivo como .env y llena los valores. El .env NUNCA se sube al repositorio.

# Cadena de conexión a PostgreSQL (local con Docker o Neon en la nube)
DATABASE_URL="postgresql://oficioya:oficioya@localhost:5432/oficioya?schema=public"

# Secreto para firmar los JWT de acceso (mínimo 32 caracteres aleatorios)
JWT_SECRET=""

# Clave AES-256 para cifrar las identificaciones (32 bytes en base64)
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IDENTITY_ENC_KEY=""

PORT=3000
NODE_ENV=development

# Orígenes permitidos para CORS, separados por coma (frontend publicado y desarrollo local)
CORS_ORIGIN="https://equipo6.centrofuyuan.com,http://localhost:5173"

# Carpetas de archivos: públicos (fotos de perfil y de solicitudes) y privados (identificaciones cifradas)
PUBLIC_UPLOADS_DIR="./uploads"
PRIVATE_STORAGE_DIR="./storage"

# En producción, true para redirigir HTTP a HTTPS (RNF-02)
FORCE_HTTPS=false
